# Engine environment variables — copy to .env and fill in real values

# Polygon.io API key (options data layer)
POLYGON_KEY=

# Finazon data key
FINAZON_KEY=

# Polygon request rate cap (optional, default 100 req/min)
POLYGON_RATE_PER_MIN=100

# OpenAI
OPENAI_API_KEY=

# Pinecone
PINECONE_API_KEY=
PINECONE_HOST=

# Postgres (Cloud SQL via Auth Proxy on localhost:5432 for local dev)
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Alpha Vantage
AV_KEY=

# Engine bearer token
KEY=

# Encryption key (Fernet, 32-byte URL-safe base64)
ENCRYPTION_KEY=

# IPInfo (for geo-blocking middleware)
IPINFO_TOKEN=

# Google Custom Search
GOOGLE_SEARCH_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Internal skeleton key
SKELETON_KEY=

# Anthropic Claude API key — used by AI subagents (RESEARCH, AUTHOR, BACKTEST, PROPOSE)
ANTHROPIC_API_KEY=

# Demo session caps (forwarded from server as X-Demo-Session: true)
DEMO_AGENT_RATE_LIMIT_PER_MINUTE=10
ANTHROPIC_MODEL_DEMO=claude-haiku-4-5
ANTHROPIC_MODEL=claude-sonnet-4-6
REDIS_URL=redis://localhost:6379/0
